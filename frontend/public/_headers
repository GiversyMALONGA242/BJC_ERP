# Render Static - Desactive le cache pour index.html pour que Googlebot ait toujours le neuf
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/sitemap.xml
  Cache-Control: no-cache

/robots.txt
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
